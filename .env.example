# Supabase (프로젝트 대시보드 → Settings → API 에서 복사)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (명함 추출용) — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# 로그인 화이트리스트 — 이 이메일만 매직 링크 발송
ALLOWED_LOGIN_EMAIL=

# Google Sheets 동기화 (선택, 마지막 단계에서만)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
